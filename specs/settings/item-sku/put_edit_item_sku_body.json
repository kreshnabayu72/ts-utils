{
  "brand": "string,objectId", // Brand _id
  "model": "string,objectId", // Model _id
  "sku": "string",
  "skuAlias": "string,optional",
  "minimumStock": "number",
  "safetyStock": "number,optional",
  "minimumAndSafetyStockSettings": "string", // Possible values: "Set globally", "Set for each administrative group", "Set for each group".
  "allowMinimumAndSafetyStock": "boolean",
  "tagType": "string",
  "hasProductionDate": "boolean",
  "hasExpiredDate": "boolean",
  "hasBarcode": "boolean",
  "barcode": "string,optional", // Only set this if hasBarcode field is `true`.
  "firstImage": "file,optional",
  "secondImage": "file,optional", // Only set this if firstImage field is already filled.
  "defaultImage": "string,optional", // Possible values: "firstImage", "secondImage"
  "customFields": "any"
}